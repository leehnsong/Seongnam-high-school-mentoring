# secrets
.env

# python
__pycache__/
*.pyc
.pytest_cache/
.conda/

# data & model artifacts (대용량)
datasets/raw/*
datasets/merged/*
models/*.pt
outputs/*
runs/

# sdd scratch
.superpowers/

# keep dir placeholders
# 부모 디렉토리를 통째로 무시하면 재포함이 불가하므로 dir/* 형태로 지정한다.
!datasets/raw/.gitkeep
!datasets/merged/.gitkeep
!outputs/.gitkeep

# 입력 미디어 — 폴더 구조는 유지하고 내용물만 제외
# (부정 규칙은 반드시 무시 규칙 뒤에 와야 한다 — 나중 규칙이 이긴다)
video/*
!video/.gitkeep
img/*
!img/.gitkeep

# 루트에 내려받은 사전학습 가중치 (yolo11s.pt 등)
/*.pt
